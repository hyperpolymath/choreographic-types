name      = "choreo-grade-commute"
home      = "echo-types : proofs/agda/characteristic/RoleGraded.agda:193"
status    = "PROVEN (--safe --without-K, postulate-free; verified 2026-06-16; 18 cases / 1 non-trivial)"
role-here = "Degenerate STATIC base case of K-CUT (single edge, no time). Import; do NOT restate as open."

[[imported-proven]]
id        = "imp-002"
name      = "echo grade dioid ℕ∪{∞} under (min,+)"
home      = "echo-types : proofs/agda/experimental/echo-additive/Grade.agda"
status    = "PROVEN-but-UNWIRED (compiles --safe standalone; absent from All.agda; gated R-2026-05-18)"
